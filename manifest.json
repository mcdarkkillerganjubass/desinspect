{
  "manifest_version": 3,
  "name": "Design Inspect",
  "version": "0.3.0",
  "description": "Inspect live page geometry and computed CSS with Figma-like shortcuts.",
  "permissions": ["activeTab", "scripting", "webNavigation", "storage", "debugger"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": { "default_title": "Toggle Design Inspect" },
  "background": { "service_worker": "background.js" }
}
